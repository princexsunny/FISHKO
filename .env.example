# ---- Server ----
PORT=8080

# ---- Admin auth ----
ADMIN_PASSWORD=admin123
JWT_SECRET=change-this-to-a-long-random-string

# ---- Firebase ----
# Option A (recommended on Render): paste the FULL service-account JSON on ONE line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Firebase Storage bucket, e.g. fishko-xxxx.appspot.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ---- OTP / SMS (optional, for real phone login & broadcasts) ----
# MSG91_AUTHKEY=
# TWILIO_SID=
# TWILIO_TOKEN=
